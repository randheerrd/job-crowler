generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  profileData  String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes      Resume[]
  credentials  Credential[]
  savedJobs    SavedJob[]
  applications Application[]
}

model Resume {
  id              String   @id @default(cuid())
  userId          String
  filePath        String
  extractedSkills String   // JSON array string
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Credential {
  id                String   @id @default(cuid())
  userId            String
  portal            String
  username          String
  encryptedPassword String
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id          String   @id @default(cuid())
  portal      String
  title       String
  company     String
  salary      String?
  location    String
  jobType     String
  description String
  url         String
  postedAt    DateTime
  rawData     String?  // JSON string
  createdAt   DateTime @default(now())

  savedBy      SavedJob[]
  applications Application[]
}

model SavedJob {
  userId String
  jobId  String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  jobId       String?
  manualJob   String?  // JSON string
  status      String   @default("Saved")
  dateApplied DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
}
